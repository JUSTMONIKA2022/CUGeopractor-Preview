# 行至大地·CUGeopractor 环境变量占位模板
# 使用方法：复制本文件为 .env（.env 已被 .gitignore 排除，不会进入仓库/不会被提交）
# 请勿将任何真实密钥写入仓库或提交历史！

# ===== 校园系统会话（L1 会话型连接器）=====
# 在已登录教务系统(jwgl.cug.edu.cn)的浏览器中，F12 → Application → Cookies
# 复制 jwgl.cug.edu.cn 的全部 Cookie（含 HttpOnly 的 JSESSIONID），粘贴到本机环境变量：
#   PowerShell: $env:JWGL_COOKIE="name=value; name2=value2; ..."
# 注意：该值仅为本机使用，绝不写入仓库/配置模板明文
# JWGL_COOKIE=

# ===== 社区渠道登录态（用户会话模式，可选）=====
# 以下 Cookie 均为"用户本人已登录浏览器"导出的真实会话（仅存本机，不入库），
# 用于规避匿名抓取被平台动态风控拦截；未配置时连接器走匿名/降级模式。

# 百度贴吧会话 Cookie（登录贴吧后 F12 → Application → Cookies 导出 tieba.baidu.com 全部 Cookie）
# TIEBA_COOKIE=

# 外部贴吧数据服务地址（BYO，推荐；用户自行部署 Tieba-API-SCF 后配置，见 docs/tieba-service-guide.md；
# 本项目仅以通用 HTTP 客户端调用其 /forum/thread（最新帖列表）与 /forum/search（吧内搜索）接口，
# 不含任何签名/逆向代码）
# 自部署默认端口 8000，可用 TIEBA_PORT 环境变量改端口（本机示例：start-tieba.ps1 内 TIEBA_PORT=8916）
# 默认可用公开实例：https://cf.eztb.org（第三方维护，稳定性自担；建议生产自部署）
# TIEBA_API_BASE=http://127.0.0.1:8916

# 小红书会话 Cookie（登录后 F12 导出；若账号被风控 code=300011 需换小号）
# XHS_COOKIE=

# 外部 xhs 数据服务地址（用户自行部署，见 docs/xhs-service-guide.md；配置后优先使用，
# 本项目仅以通用 HTTP 客户端调用其 /search 接口，不含任何签名/逆向代码）
# XHS_API_BASE=http://127.0.0.1:5100

# 知乎开放平台 Access Secret（开发者平台 developer.zhihu.com 申请，Bearer 鉴权）
# ZHIHU_ACCESS_SECRET=

# 学号（会话连接器请求体 xsdm 参数使用）
# CUG_USERNAME=

# ===== LLM 配置（OpenAI 兼容协议，用户自配）=====
# 模型服务 Base URL（示例：DeepSeek https://api.deepseek.com/v1；
# Qwen https://dashscope.aliyuncs.com/compatible-mode/v1；
# 本地 Ollama http://localhost:11434/v1 等）
LLM_BASE_URL=

# 模型名称（示例：deepseek-chat / qwen-plus / gpt-4o-mini / 本地模型名）
LLM_MODEL=

# API 密钥（留空则使用 app/secrets.py 的加密存储配置）
LLM_API_KEY=

# 请求超时（秒）
LLM_TIMEOUT=60

# ===== 知识库向量化（可选，默认本地内置模型）=====
# 默认使用 ChromaDB 内置本地 ONNX 小模型：免密钥、数据不出本机，
# 首次执行索引时自动下载模型权重（无需配置任何变量）。
# 如需使用外部向量化接口（更强模型 / 远程 embedding），配置以下三项：
#   EMBEDDING_BASE_URL=      # OpenAI 兼容 /embeddings 地址（如 https://api.deepseek.com/v1 或本地服务）
#   EMBEDDING_API_KEY=       # 外部 embedding 密钥（本地服务可留空）
#   EMBEDDING_MODEL=         # embedding 模型名（如 text-embedding-3-small）

# ===== 本地服务配置 =====
# Web UI 监听地址（安全要求：默认仅本机 127.0.0.1，请勿随意改为 0.0.0.0 对外暴露）
HOST=127.0.0.1
PORT=8080

# Agent API 可选鉴权 Token（默认空=不校验）。仅当需要把 8080 暴露到局域网/公网时
# 才设置；设置后 /api/chat 与 /api/agent/invoke 必须携带请求头：
#   Authorization: Bearer <该值>
# CUGEOPRACTOR_API_TOKEN=

# ===== 数据目录配置 =====
# 说明：带 CUGEOPRACTOR_ 前缀的变量优先于同名系统环境变量，可避免被系统里常见的
# DATA_DIR/KNOWLEDGE_DIR 污染（pydantic-settings 中系统环境变量优先级高于 .env）。
# 旧的无前缀写法（DATA_DIR=...）仍兼容，但推荐使用带前缀名。
# 知识库文档目录（用户自备数据源，放入后通过 CLI 重建索引）
CUGEOPRACTOR_KNOWLEDGE_DIR=data/knowledge
# 向量库/会话/密钥存储目录（本地，不入库）
CUGEOPRACTOR_DATA_DIR=data
